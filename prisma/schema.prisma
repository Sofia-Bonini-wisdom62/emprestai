generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

enum MembershipRole {
  member
  operations

  @@map("membership_role")
}

model Tenant {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String              @unique
  name                String
  createdAt           DateTime            @default(now()) @map("created_at")
  memberships         Membership[]
  equipmentCategories EquipmentCategory[]
  equipments          Equipment[]

  @@map("tenants")
}

model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  // Id da conta no Supabase Auth, sem FK para auth.users (spec 001, RN-18).
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Profile {
  // O mesmo id da conta no Supabase Auth, sem FK para auth.users (spec 001, RN-18).
  id        String   @id @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

model RateLimit {
  // SHA-256 de "ip:<ip>" ou "email:<e-mail>": a tabela não guarda IP nem e-mail em claro.
  key             String   @id
  count           Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)

  @@map("rate_limits")
}

// Situação do equipamento, com as chaves do glossário do AGENTS.md, seção 7 (spec 003, RN-03).
enum EquipmentStatus {
  available
  loaned
  maintenance
  out_of_service

  @@map("equipment_status")
}

model EquipmentCategory {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  name       String
  createdAt  DateTime    @default(now()) @map("created_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipments Equipment[]

  @@unique([tenantId, name])
  // Alvo da FK composta de equipments: a categoria é sempre da mesma área do equipamento.
  @@unique([tenantId, id])
  @@map("equipment_categories")
}

model Equipment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  // Patrimônio (spec 003, RN-02).
  assetTag    String            @map("asset_tag")
  name        String
  categoryId  String            @map("category_id") @db.Uuid
  status      EquipmentStatus
  // Nome do objeto no bucket equipment-images, <patrimonio>-<idPexels>.jpg (spec 003, RN-04).
  imageObject String            @map("image_object")
  createdAt   DateTime          @default(now()) @map("created_at")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category    EquipmentCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, assetTag])
  @@index([categoryId])
  @@map("equipments")
}
