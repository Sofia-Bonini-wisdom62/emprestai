generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

enum MembershipRole {
  member
  operations

  @@map("membership_role")
}

model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]

  @@map("tenants")
}

model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  // Id da conta no Supabase Auth, sem FK para auth.users (spec 001, RN-18).
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Profile {
  // O mesmo id da conta no Supabase Auth, sem FK para auth.users (spec 001, RN-18).
  id        String   @id @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

model RateLimit {
  // SHA-256 de "ip:<ip>" ou "email:<e-mail>": a tabela não guarda IP nem e-mail em claro.
  key             String   @id
  count           Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)

  @@map("rate_limits")
}
