generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

enum MembershipRole {
  member
  operations

  @@map("membership_role")
}

model Tenant {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String              @unique
  name                String
  createdAt           DateTime            @default(now()) @map("created_at")
  memberships         Membership[]
  equipmentCategories EquipmentCategory[]
  equipments          Equipment[]
  loans               Loan[]
  auditEvents         AuditEvent[]

  @@map("tenants")
}

model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  // Id da conta no Supabase Auth, sem FK para auth.users (spec 001, RN-18).
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  loans     Loan[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Profile {
  // O mesmo id da conta no Supabase Auth, sem FK para auth.users (spec 001, RN-18).
  id        String   @id @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

model RateLimit {
  // SHA-256 de "ip:<ip>" ou "email:<e-mail>": a tabela não guarda IP nem e-mail em claro.
  key             String   @id
  count           Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)

  @@map("rate_limits")
}

// Situação do equipamento, com as chaves do glossário do AGENTS.md, seção 7 (spec 003, RN-03).
enum EquipmentStatus {
  available
  loaned
  maintenance
  out_of_service

  @@map("equipment_status")
}

model EquipmentCategory {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  name       String
  createdAt  DateTime    @default(now()) @map("created_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipments Equipment[]

  @@unique([tenantId, name])
  // Alvo da FK composta de equipments: a categoria é sempre da mesma área do equipamento.
  @@unique([tenantId, id])
  @@map("equipment_categories")
}

model Equipment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  // Patrimônio (spec 003, RN-02).
  assetTag    String            @map("asset_tag")
  name        String
  categoryId  String            @map("category_id") @db.Uuid
  status      EquipmentStatus
  // Nome do objeto no bucket equipment-images, <patrimonio>-<idPexels>.jpg (spec 003, RN-04).
  imageObject String            @map("image_object")
  createdAt   DateTime          @default(now()) @map("created_at")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category    EquipmentCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  loans       Loan[]

  @@unique([tenantId, assetTag])
  // Alvo da FK composta de loans: o empréstimo é sempre da mesma área do equipamento (spec 004).
  @@unique([tenantId, id])
  @@index([categoryId])
  @@map("equipments")
}

// Empréstimo (spec 004). O índice único parcial "loans_equipment_id_open_key", um empréstimo em
// aberto por equipamento (RN-09), está só no SQL da migration: o Prisma não modela índice parcial.
model Loan {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  equipmentId String     @map("equipment_id") @db.Uuid
  // Id da conta no Supabase Auth, sem FK para auth.users (spec 001, RN-18); a FK composta é com
  // memberships, para quem pega o item ter vínculo na área.
  userId      String     @map("user_id") @db.Uuid
  // A confirmação do pedido (RN-01).
  createdAt   DateTime   @default(now()) @map("created_at")
  // Data prevista de devolução, no calendário de America/Sao_Paulo (RN-04).
  dueOn       DateTime   @map("due_on") @db.Date
  returnedAt  DateTime?  @map("returned_at")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipment   Equipment  @relation(fields: [tenantId, equipmentId], references: [tenantId, id], onDelete: Restrict)
  membership  Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, userId])
  @@map("loans")
}

// Auditoria append-only (ADR-001, 2.10; ADR-010; spec 004, RN-22). O trigger que recusa UPDATE,
// DELETE e TRUNCATE está no SQL da migration.
model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("audit_events")
}
