# ============================================================
# emprestai — variáveis de ambiente
# Copie para .env.local e preencha. .env.local está no .gitignore.
# Referência: docs/adr/001-stack.md e docs/adr/003-stack-corrections.md (seções 2.5, 2.7, 2.9, 2.10)
# e docs/adr/004-environments.md (ambientes e bancos).
# Onde cada variável vive: por padrão no .env.local e na Vercel (Production e Preview).
# Quando é diferente, a linha "onde:" acima dela diz (rules/secrets.md, passo 3).
# ============================================================

# ---------- Cliente (NEXT_PUBLIC_ vai para o bundle; nunca segredo) ----------
# Supabase > Project Settings > Data API > Project URL. Formato: https://<project-ref>.supabase.co
# onde: Production. No .env.local, não é usada até a spec de login decidir como o dev autentica
# (ADR-004); pode ficar vazia. O único projeto Supabase é o de produção. Preview: hoje tem a do projeto
# de produção, que é pública e pode ficar; a spec de login decide se continua.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API Keys > Publishable key. Formato: sb_publishable_...
# onde: o mesmo da NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sentry > Project Settings > Client Keys (DSN). Vazio em dev = não envia nada.
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Servidor (só em src/env/server.ts, atrás de import 'server-only') ----------
# No .env.local, DATABASE_URL e DIRECT_URL apontam SEMPRE para o Postgres local do compose.yaml
# (ADR-004), e as duas têm a mesma URL: no dev não há pooler.
# No projeto de produção (ref zawqxqukgaqjlbtwiogb), o schema só muda pelo GitHub Actions; o dado, pela
# aplicação na Vercel e, só a área default e o vínculo do primeiro administrador, pelo passo do
# workflow (ADR-009). Ver rules/restrictions.md.
# Produção (Vercel e job de migrate): runtime pelo Supavisor transaction mode, porta 6543, com ?pgbouncer=true;
# migration pelo session pooler, porta 5432. Supabase > Connect.
# No Prisma 7 o limite de 1 conexão vai em new PrismaPg({ max: 1 }), não na URL.
# onde: .env.local (Postgres local), Production (pooler 6543) e Preview com um valor que não aponta
# para banco nenhum (ADR-004). Nunca a URL do banco de produção no Preview nem no .env.local.
DATABASE_URL=postgresql://postgres:<senha-local>@127.0.0.1:54322/postgres
# Migration e seed.
# onde: .env.local e o job de migrate do GitHub Actions (session pooler 5432). Não vai para a Vercel.
DIRECT_URL=postgresql://postgres:<senha-local>@127.0.0.1:54322/postgres
# Senha do Postgres local do compose.yaml. É a mesma <senha-local> das duas URLs acima, então
# use só letras e números: ela entra na URL sem escape. Trocar depois exige recriar o volume.
# onde: só .env.local.
POSTGRES_PASSWORD=<senha-local>
# Supabase > Project Settings > API Keys > Secret keys. Formato: sb_secret_... Passa por cima da RLS.
# onde: só Production. Nunca no Preview nem no .env.local (rules/restrictions.md, Bancos e schema).
SUPABASE_SECRET_KEY=
# URL canônica do app. Produção: https://<app>.vercel.app.
# onde: .env.local e Production. Preview: vazia (derivada das VERCEL_*).
APP_URL=http://localhost:3000

# ---------- Observabilidade ----------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Liga pino-pretty.
# onde: só .env.local. Ignorada na Vercel.
LOG_PRETTY=true
# Upload de source maps no build (Vercel, marcado Sensitive). Opcional em dev.
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---------- Rate limit (contador no Postgres) ----------
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_USER_WINDOW_SECONDS=60

# ---------- CI (GitHub Actions) ----------
# Credenciais da CLI da Vercel para o deploy de produção (ADR-007).
# VERCEL_TOKEN: token de conta (Account Settings > Tokens), com escopo no time do projeto
# e com validade. Quem tem o token publica o projeto: trate como senha.
# VERCEL_ORG_ID: Team ID (Team Settings > General). VERCEL_PROJECT_ID: Project ID
# (Project Settings > General).
# onde: só nos secrets do GitHub Actions. Não vão para o .env.local nem para a Vercel.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ---------- Local ----------
# onde: só .env.local.
PORT=3000
