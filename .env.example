# ============================================================
# emprestai — variáveis de ambiente
# Copie para .env.local e preencha. .env.local está no .gitignore.
# Referência: docs/adr/001-stack.md e docs/adr/003-stack-corrections.md (seções 2.5, 2.7, 2.9, 2.10)
# e docs/adr/004-environments.md (ambientes e bancos); docs/adr/006-dev-auth.md (Auth no dev).
# Onde cada variável vive: por padrão no .env.local e na Vercel (Production e Preview).
# Quando é diferente, a linha "onde:" acima dela diz (rules/secrets.md, passo 3).
# ============================================================

# ---------- Cliente (NEXT_PUBLIC_ vai para o bundle; nunca segredo) ----------
# URL do Supabase. No .env.local, o gateway do compose.yaml, como abaixo (ADR-006).
# Produção: Supabase > Project Settings > Data API > Project URL. Formato: https://<project-ref>.supabase.co
# onde: .env.local (gateway local) e Production. Nunca no Preview: sem ela, o /login do Preview
# mostra a mensagem genérica de erro (RN-34 da spec 001).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publishable. Formato: sb_publishable_... No .env.local, a gerada para o Auth da máquina
# (seção "Auth local", abaixo); o compose.yaml a passa ao gateway.
# Produção: Supabase > Project Settings > API Keys > Publishable key.
# onde: o mesmo da NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sentry > Project Settings > Client Keys (DSN). Vazio em dev = não envia nada.
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Servidor (só em src/env/server.ts, atrás de import 'server-only') ----------
# No .env.local, DATABASE_URL e DIRECT_URL apontam SEMPRE para o Postgres local do compose.yaml
# (ADR-004), e as duas têm a mesma URL: no dev não há pooler.
# No projeto de produção (ref zawqxqukgaqjlbtwiogb), o schema só muda pelo GitHub Actions; o dado, pela
# aplicação na Vercel e, só a área default e o vínculo do primeiro administrador, pelo passo do
# workflow (ADR-009). Ver rules/restrictions.md.
# Produção (Vercel e job de migrate): runtime pelo Supavisor transaction mode, porta 6543, com ?pgbouncer=true;
# migration pelo session pooler, porta 5432. Supabase > Connect.
# No Prisma 7 o limite de 1 conexão vai em new PrismaPg({ max: 1 }), não na URL.
# onde: .env.local (Postgres local), Production (pooler 6543) e Preview com um valor que não aponta
# para banco nenhum (ADR-004). Nunca a URL do banco de produção no Preview nem no .env.local.
DATABASE_URL=postgresql://postgres:<senha-local>@127.0.0.1:54322/postgres
# Migration e seed.
# onde: .env.local e o job de migrate do GitHub Actions (session pooler 5432). Não vai para a Vercel.
DIRECT_URL=postgresql://postgres:<senha-local>@127.0.0.1:54322/postgres
# Senha do Postgres local do compose.yaml. É a mesma <senha-local> das duas URLs acima, então
# use só letras e números: ela entra na URL sem escape. Trocar depois exige recriar o volume.
# onde: só .env.local.
POSTGRES_PASSWORD=<senha-local>
# Chave secreta. Formato: sb_secret_... Passa por cima da RLS.
# Produção: Supabase > Project Settings > API Keys > Secret keys.
# No .env.local, só a gerada para o Auth da máquina (seção "Auth local", abaixo), que o compose.yaml
# passa ao gateway e que só o seed e o setup do E2E leem (rules/secrets.md).
# onde: Production (a de produção) e .env.local (só a local). Nunca a de produção no .env.local;
# nunca no Preview (rules/restrictions.md, Bancos e schema).
SUPABASE_SECRET_KEY=
# URL canônica do app. Produção: https://<app>.vercel.app.
# onde: .env.local e Production. Preview: vazia (derivada das VERCEL_*).
APP_URL=http://localhost:3000

# ---------- Auth local (só o compose.yaml lê; a aplicação não usa) ----------
# Chaves do Auth e do gateway da máquina (ADR-006, seção 2). Nenhuma vale fora dela.
# Geradas uma vez, numa pasta fora do repositório, pelo script oficial add-new-auth-keys.sh
# (github.com/supabase/supabase, docker/utils/), que precisa do Node e de um .env com o JWT_SECRET:
#   node -e "console.log('JWT_SECRET='+require('crypto').randomBytes(32).toString('hex'))" > .env
#   touch docker-compose.yml   (o script edita esse arquivo; vazio, ele só avisa)
#   sh add-new-auth-keys.sh --update-env
# O .env dessa pasta fica com as chaves. Copie para cá: JWT_SECRET, JWT_KEYS, ANON_KEY_ASYMMETRIC,
# SERVICE_ROLE_KEY_ASYMMETRIC e SUPABASE_SECRET_KEY com o mesmo nome; SUPABASE_PUBLISHABLE_KEY vira
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. O JWT_JWKS não é usado. Depois, apague a pasta.
# onde: só .env.local.
# Segredo HS256. O Auth o exige mesmo assinando em ES256, e ele também entra no JWT_KEYS.
JWT_SECRET=
# Par de chaves ES256 em JWK, com a parte privada, mais a chave HS256. O Auth assina com ele.
JWT_KEYS=
# JWTs internos que o gateway põe no lugar das chaves sb_ antes de chamar o Auth.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ---------- Seed (pnpm prisma db seed; só dev e E2E) ----------
# Senha da conta fictícia de Operações que o seed cria no Auth da máquina: Flávia Rocha,
# flavia.rocha@example.com (spec 001, CA-02). Pelo menos 6 caracteres, e nunca uma senha sua de
# verdade. Rodar o seed de novo deixa a conta com a senha que estiver aqui.
# O seed lê também DIRECT_URL, NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SECRET_KEY, e recusa endereço
# que não seja da máquina.
# onde: só .env.local.
SEED_PASSWORD=

# ---------- Observabilidade ----------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Liga pino-pretty.
# onde: só .env.local. Ignorada na Vercel.
LOG_PRETTY=true
# Upload de source maps no build (Vercel, marcado Sensitive). Opcional em dev.
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---------- Rate limit (contador no Postgres) ----------
# Tentativas de entrar e pedidos de redefinição de senha somam juntos (RN-09 e RN-43 da spec 001).
# IP: 30 em 60 s. USER é o contador por e-mail: 5 em 15 min. Vazias, valem estes mesmos números.
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=5
RATE_LIMIT_USER_WINDOW_SECONDS=900

# ---------- CI (GitHub Actions) ----------
# Credenciais da CLI da Vercel para o deploy de produção (ADR-007).
# VERCEL_TOKEN: token de conta (Account Settings > Tokens), com escopo no time do projeto
# e com validade. Quem tem o token publica o projeto: trate como senha.
# VERCEL_ORG_ID: Team ID (Team Settings > General). VERCEL_PROJECT_ID: Project ID
# (Project Settings > General).
# onde: só nos secrets do GitHub Actions. Não vão para o .env.local nem para a Vercel.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# E-mail da conta que a pessoa convidou pelo painel do Supabase de produção para ser o primeiro
# administrador. O passo do ADR-009 (prisma/first-admin.ts) dá a ela o papel de Operações na área
# default. Sem o secret, ou sem a conta, o passo só avisa e o deploy segue.
# onde: só nos secrets do GitHub Actions. Não vai para o .env.local nem para a Vercel.
# FIRST_ADMIN_EMAIL=

# ---------- Imagens dos equipamentos (skill imagens-equipamentos, spec 002) ----------
# Chave da API do Pexels, da conta da pessoa: pexels.com/api/key, logado. A emissão de chaves novas
# está pausada desde, no máximo, 2026-09-30 (ADR-011). Só o scripts/lib/api-key.ts da skill a lê.
# onde: só .env.local. Não vai para a Vercel: as fotos já ficam prontas no Storage.
PEXELS_API_KEY=

# ---------- Local ----------
# onde: só .env.local.
PORT=3000
