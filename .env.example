# ============================================================
# emprestai — variáveis de ambiente
# Copie para .env.local e preencha. .env.local está no .gitignore.
# Referência: docs/adr/001-stack.md (seções 2.5, 2.7, 2.9, 2.10)
# ============================================================

# ---------- Cliente (NEXT_PUBLIC_ vai para o bundle; nunca segredo) ----------
# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Sentry > Project Settings > Client Keys (DSN). Vazio em dev = não envia nada.
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Servidor (só em src/env/server.ts, atrás de import 'server-only') ----------
# No .env.local, DATABASE_URL e DIRECT_URL apontam SEMPRE para o projeto Supabase de DEV.
# O de produção (ref zawqxqukgaqjlbtwiogb) só é tocado pelo GitHub Actions. Ver rules/restrictions.md.
# Runtime: Supavisor transaction mode, porta 6543. Supabase > Connect > Transaction pooler.
# No Prisma 7 o limite de 1 conexão vai em new PrismaPg({ max: 1 }), não na URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha-url-encoded>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migration e seed: Supavisor session mode, porta 5432. Supabase > Connect > Session pooler.
# Só em dev local e no job de migrate do GitHub Actions. Não configurar na Vercel.
DIRECT_URL=postgresql://postgres.<project-ref>:<senha-url-encoded>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). Bypassa RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# URL canônica do app. Produção: https://<app>.vercel.app. Preview: deixar vazio (derivado das VERCEL_*).
APP_URL=http://localhost:3000

# ---------- Observabilidade ----------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Só em máquina de dev: liga pino-pretty. Ignorado na Vercel.
LOG_PRETTY=true
# Upload de source maps no build (Vercel, marcado Sensitive). Opcional em dev.
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---------- Rate limit (contador no Postgres) ----------
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_USER_WINDOW_SECONDS=60

# ---------- Local ----------
PORT=3000
