# Configuração fixa do gateway (ADR-006), a mesma no dev (compose.yaml) e na pilha do E2E
# (tests/e2e/stack.ts). As chaves e a URL pública ficam em cada um.
# Vazias de propósito: sem as chaves legadas, o gateway só aceita as sb_.
ANON_KEY=
SERVICE_ROLE_KEY=
# O filtro basic_auth da configuração oficial protege o painel, que aqui não existe, e fica
# desligado em todas as rotas. Os dois valores só existem porque o entrypoint oficial os lê.
DASHBOARD_USERNAME=sem-painel
DASHBOARD_PASSWORD=sem-painel
